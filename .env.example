# ==============================================================================
# سامانه جامع «اورژانس خودرو» | Auto Emergency (Suggested Working Title)
# فایل نمونه متغیرهای محیطی — هیچ کلید یا راز واقعی در این فایل قرار ندهید!
# ==============================================================================

# محیط اجرا: development | test | staging | production
APP_ENV=development
NODE_ENV=development

# تنظیمات شبکه و آدرس Backend
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=

# تنظیمات پایگاه داده (SQLite فایل‌محور با قابلیت مهاجرت به PostgreSQL)
DATABASE_PATH=./data/auto_emergency.db
DATABASE_BACKUP_DIR=./backups

# تنظیمات امنیت و نشست‌ها (در محیط Production حتماً یک کلید تصادفی حداقل ۳۲ کاراکتری تنظیم شود)
SESSION_SECRET=CHANGE_ME_IN_PRODUCTION_WITH_CRYPTO_RANDOM_64_HEX_CHARS
SESSION_COOKIE_NAME=ae_session
SESSION_TTL_HOURS=72
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# تنظیمات سرویس نقشه و مکان‌یابی (osm | neshan | mapir | vector_qazvin)
MAP_PROVIDER=vector_qazvin
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NESHAN_API_KEY=
MAPIR_API_KEY=

# تنظیمات سرویس پیامک (sandbox_outbox | kavenegar)
# در حالت sandbox_outbox پیام‌ها به‌صورت شفاف با برچسب آزمایشی در جدول خروجی ثبت می‌شوند
SMS_PROVIDER=sandbox_outbox
KAVENEGAR_API_KEY=
SMS_SENDER_NUMBER=

# تنظیمات درگاه پرداخت (sandbox | zarinpal)
# در Production فقط زرین‌پال عملیاتی با شناسه واقعی مجاز است؛ هر دو گزینه Sandbox باید false باشند.
PAYMENT_PROVIDER=sandbox
ENABLE_SANDBOX_GATEWAY=true
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# تنظیمات ذخیره‌سازی خصوصی فایل‌ها و تصاویر مأموریت
PRIVATE_STORAGE_DIR=./storage/private
MAX_UPLOAD_SIZE_BYTES=5242880

# تنظیمات لاگ و پایش
LOG_LEVEL=info
ENABLE_SECURITY_AUDIT_LOG=true

# ویژگی‌های فعال سامانه (Feature Flags)
FEATURE_ENABLE_DEV_SEED=true
FEATURE_ALLOW_EV_SERVICES=true
FEATURE_ALLOW_POSTPAY_DEBT=false
# در Production پیش‌فرض false است؛ فقط پس از مجوزها، ناوگان، خط واقعی پشتیبانی و تست پذیرش true شود.
ENABLE_PUBLIC_OPERATIONS=false
